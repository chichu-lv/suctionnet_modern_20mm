{
  "schema_version": "suction20.finetune.v1",
  "stage": "target_finetune",
  "mode": "attempt_success",
  "seed": 42,
  "init_checkpoint": "${PRETRAIN_RUN}/runs/E5_seed42/best.pt",
  "target_data": {
    "manifest": "${FINETUNE_RUN}/data/manifest_attempt_success.jsonl",
    "schema_version": "suction20.target.v1",
    "split_field": "split",
    "group_field": "group_id",
    "train_sampler": "uniform_group_then_frame_or_attempt",
    "label_kind": "attempt_success",
    "success_definition": "completed_pick_and_transfer",
    "missing_label_policy": "mask_false",
    "anchor_feature": "source_index_else_same_instance_nearest_observation",
    "nearest_observation_radius_m": 0.005,
    "score_pose": "human_reviewed_published_planning_command",
    "unmapped_attempt_policy": "skip_supervision_not_negative",
    "pose_provenance": {
      "pose_source": "planned_pipeline_contact",
      "actual_execution_verified": false,
      "gravity_source": "negative_shared_belt_plane_normal_approximation",
      "success_definition": "completed_pick_and_transfer",
      "notice": "Manually reviewed outcome linked to one published planning command; neither commanded pose nor numeric calibration is independently measured actual contact ground truth."
    }
  },
  "source_replay": {
    "enabled": true,
    "source_root": "${SOURCE_RELEASE}/work/prepare/0000/2eeec9465e6c41f1b6284c0de808e58c/input_raw",
    "label_root": "${SOURCE_RELEASE}/output",
    "frozen_label_config": "${SOURCE_RELEASE}/output/config_frozen.json",
    "camera": "realsense",
    "source_format": "legacy_dc4ad6b",
    "compatibility": "auto",
    "legacy_producer": "dc4ad6b00535c89ece1feef2751ba86006e5f97e",
    "adapter_read_only": true,
    "adapter_cache": null,
    "scene_split": "source_checkpoint_train_split",
    "source_frames_per_optimizer_step": 2,
    "scene_cache_size": 90,
    "object_cache_size": 88
  },
  "model": {
    "architecture": "from_source_checkpoint",
    "quality_target": "gt_B",
    "task_success_head": {
      "enabled": true,
      "input": [
        "pose_features_256",
        "executed_normal_cam_3",
        "normal_dot_gravity_1"
      ],
      "input_dim": 260,
      "hidden_dim": 128,
      "output_dim": 1,
      "output": "logit",
      "activation": "ReLU",
      "hidden_normalization": "LayerNorm",
      "initialization": "inherit_if_present_else_random_weights_zero_bias"
    },
    "physical_geometry_source": "source_checkpoint",
    "seal_normalization_source": "source_checkpoint"
  },
  "loss": {
    "target_loss": "attempted_pose_bce_with_logits",
    "target_weight": 1.0,
    "target_bce_pos_weight": 1.0,
    "target_quality_proxy_supervision": false,
    "target_normal_supervision": false,
    "target_aux_component_supervision": false,
    "proposal_q0_in_task_features": false,
    "source_loss": "source_checkpoint_physical_losses",
    "source_weight": 0.5,
    "domain_reduction": "separate_target_and_source_means",
    "microbatch_frame_weights": {
      "target": 0.5,
      "source": 0.25
    },
    "additional_divide_by_accumulation_steps": false
  },
  "optimizer": {
    "name": "AdamW",
    "create_fresh_on_init_checkpoint": true,
    "weight_decay": 0.0001,
    "no_weight_decay": [
      "bias",
      "normalization_parameters"
    ],
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "grad_clip_norm": 10.0
  },
  "training": {
    "max_optimizer_steps": 1000,
    "target_frames_per_optimizer_step": 2,
    "effective_batch_size": 4,
    "world_size": 1,
    "microbatch_size": 1,
    "accumulated_microbatches_per_optimizer_step": 4,
    "amp": true,
    "encoder_frozen": true,
    "bn_mode": "eval",
    "bn_affine_trainable": false,
    "phases": [
      {
        "name": "heads_only",
        "start_optimizer_step": 0,
        "end_optimizer_step_exclusive": 200,
        "train_groups": [
          "heads"
        ],
        "lr": {
          "heads": 0.0003,
          "decoder": 0.0
        }
      },
      {
        "name": "decoder_and_heads",
        "start_optimizer_step": 200,
        "end_optimizer_step_exclusive": 1000,
        "train_groups": [
          "decoder",
          "heads"
        ],
        "lr": {
          "heads": 0.0001,
          "decoder": 1e-05
        }
      }
    ],
    "preserve_heads_optimizer_state_at_phase_change": true
  },
  "augmentation": {
    "scale": false,
    "yaw_about_gravity_deg": [
      -180.0,
      180.0
    ],
    "translation_in_table_plane_m": [
      -0.02,
      0.02
    ],
    "depth_noise_std_m": 0.0,
    "point_dropout_fraction": [
      0.0,
      0.0
    ],
    "transform_explicit_pose_and_gravity": true
  },
  "validation": {
    "evaluate_source_initialization": true,
    "source_baseline_score": "q_at_recorded_planning_command_pose",
    "finetuned_score": "task_success_at_recorded_planning_command_pose",
    "every_optimizer_steps": 100,
    "always_save_step_200": true,
    "selection_metric": "attempt_AUROC",
    "selection_mode": "max",
    "report_metrics": [
      "attempt_AUROC",
      "attempt_PR_AUC",
      "labeled_attempt_count",
      "independent_GROUP02ount"
    ],
    "zero_shot_q_as_probability": false
  },
  "ranking": {
    "final_score": "task_success_score",
    "multiply_by_q": false,
    "uncertainty_lambda": 0.0,
    "postprocessing": "inherit_source_config"
  },
  "runtime": {
    "cpu_threads": 8,
    "gpu_memory_limit_gib": null,
    "backbone_root": "${BACKBONE_ROOT}",
    "performance": {
      "fps_backend": "compiled",
      "spatial_index": {
        "backend": "uniform_grid_cpu",
        "cell_size_m": 0.02
      },
      "contact_query_backend": "native_cpu",
      "contact_feature_gather_mode": "zone",
      "no_instance_voxel_heads": false,
      "backbone_coordinate_fastpath": true,
      "dense_chunk_size_override": 65536,
      "chunk_input_mode": "split",
      "geometry_threads": 8,
      "geometry_precision": "float32",
      "instance_broadcast_mode": "segment",
      "compile_dense_heads": false,
      "query_chunk_size": null,
      "query_workers": 1,
      "detailed_cpu_timing": false
    }
  },
  "sampling_seed": 20261110
}
